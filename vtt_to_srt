#!/usr/bin/env python3

import argparse
from fractions import Fraction
from html import escape
from pathlib import Path
import xml.etree.ElementTree as ET
import os
import re


SUPPORTED_EXTENSIONS = [".xml", ".vtt"]


def to_srt(text, extension):
    if extension.lower() == ".xml":
        return xml_to_srt(text)
    if extension.lower() == ".vtt":
        return vtt_to_srt(text)


VTT_STAMP = r"(?:(?:[0-9]{2,}):)?[0-5][0-9]:[0-5][0-9]\.[0-9]{3}"
VTT_TIMING = re.compile(
    rf"({VTT_STAMP})[ \t]+-->[ \t]+({VTT_STAMP})(?:[ \t]+[^\n]*)?"
)
VTT_TAG = re.compile(r"<([^<>\n]+)>")


def convert_vtt_time(line):
    match = VTT_TIMING.fullmatch(line.strip())
    if not match:
        raise ValueError(f"Invalid WebVTT timing: {line}")
    times = []
    for stamp in match.groups():
        if stamp.count(":") == 1:
            stamp = "00:" + stamp
        times.append(stamp.replace(".", ","))
    return " --> ".join(times)


def get_vtt_styles(blocks):
    styles = {}
    for block in blocks:
        lines = block.splitlines()
        if not lines or lines[0].strip() != "STYLE":
            continue
        sheet = "\n".join(lines[1:])
        for name, declarations in re.findall(r"::cue\(\.([\w-]+)\)\s*\{([^}]*)\}", sheet):
            color = re.search(r"(?:^|;)\s*color\s*:\s*(#[\da-fA-F]{3}(?:[\da-fA-F]{3})?|[a-zA-Z]+)\s*(?:;|$)", declarations)
            if color:
                styles[name] = color.group(1)
    return styles


def render_vtt_payload(lines, styles):
    colors = []

    def replace_tag(match):
        tag = match.group(1)
        if tag == "c" or tag.startswith("c."):
            color = next((styles[c] for c in tag.split(".")[1:] if c in styles), None)
            colors.append(color)
            return f'<font color="{color}">' if color else ""
        if tag == "/c" or tag.startswith("/c."):
            return "</font>" if colors and colors.pop() else ""
        if re.fullmatch(VTT_STAMP, tag) or tag in ("/v", "/lang") or tag.startswith(("v ", "lang ")):
            return ""
        return match.group()

    body = VTT_TAG.sub(replace_tag, "\n".join(lines))
    return body + "</font>" * sum(bool(color) for color in colors)


def vtt_to_srt(text):
    text = text.removeprefix("\ufeff").replace("\r\n", "\n").replace("\r", "\n")
    blocks = re.split(r"\n[ \t]*\n", text)
    header = blocks[0].split("\n", 1)[0]
    if not re.fullmatch(r"WEBVTT(?:[ \t].*)?", header):
        raise ValueError("Expected a WEBVTT header.")
    styles = get_vtt_styles(blocks[1:])
    cues = []
    for block in blocks[1:]:
        lines = block.strip("\n").splitlines()
        if not lines or lines[0] in ("STYLE", "REGION") or re.match(r"^NOTE(?:[ \t]|$)", lines[0]):
            continue
        index = 0 if "-->" in lines[0] else 1
        if index >= len(lines) or "-->" not in lines[index]:
            continue
        timing = convert_vtt_time(lines[index])
        content = render_vtt_payload(lines[index + 1:], styles)
        if content:
            cues.append(f"{len(cues) + 1}\n{timing}\n{content}")
    return "\n\n".join(cues) + ("\n" if cues else "")


def local_name(name):
    return name.rsplit("}", 1)[-1]


def xml_attrs(node):
    return {local_name(key): value for key, value in node.attrib.items()}


class SubtitleClock:
    def __init__(self, root):
        attrs = xml_attrs(root)
        if attrs.get("timeBase", "media") != "media":
            raise ValueError("This converter supports media-time subtitles.")
        rate = Fraction(attrs.get("frameRate", "30"))
        numerator, denominator = map(int, attrs.get("frameRateMultiplier", "1 1").split())
        self.frames = rate * Fraction(numerator, denominator)
        self.subframes = int(attrs.get("subFrameRate", "1"))
        default_ticks = self.frames * self.subframes if "frameRate" in attrs else 1
        self.ticks = Fraction(attrs.get("tickRate", default_ticks))
        if min(self.frames, self.subframes, self.ticks) <= 0:
            raise ValueError("Subtitle timing rates must be positive.")
        # Legacy DFXP downloads store bare integers as 100-nanosecond ticks.
        self.bare_ticks = self.ticks if "tickRate" in attrs else 10_000_000

    def seconds(self, text):
        if text.isdecimal():
            return Fraction(int(text), self.bare_ticks)
        offset = re.fullmatch(r"(\d+(?:\.\d+)?)(ms|h|m|s|f|t)", text)
        if offset:
            amount, unit = offset.groups()
            factor = {"ms": Fraction(1, 1000), "h": 3600, "m": 60, "s": 1,
                      "f": 1 / self.frames, "t": 1 / self.ticks}
            return Fraction(amount) * factor[unit]
        clock = re.fullmatch(r"(\d+):([0-5]\d):([0-5]\d)(?:\.(\d+)|:(\d+)(?:\.(\d+))?)?", text)
        if not clock:
            raise ValueError(f"Unsupported subtitle time {text!r}")
        hours, minutes, seconds, decimal, frames, subframes = clock.groups()
        whole = int(hours) * 3600 + int(minutes) * 60 + int(seconds)
        if frames:
            return whole + (int(frames) + Fraction(int(subframes or 0), self.subframes)) / self.frames
        return whole + Fraction("0." + (decimal or "0"))


def srt_stamp(seconds):
    whole, milliseconds = divmod(int(seconds * 1000), 1000)
    minutes, seconds = divmod(whole, 60)
    hours, minutes = divmod(minutes, 60)
    return f"{hours:02}:{minutes:02}:{seconds:02},{milliseconds:03}"


def xml_to_srt(text):
    root = ET.fromstring(text)
    if local_name(root.tag) != "tt":
        raise ValueError("Expected a timed-text document with a tt root.")
    clock = SubtitleClock(root)
    styles = {}
    top_regions = set()
    for node in root.iter():
        attrs = xml_attrs(node)
        if local_name(node.tag) == "style" and "id" in attrs:
            styles[attrs["id"]] = attrs
        if local_name(node.tag) == "region" and attrs.get("displayAlign") == "before":
            top_regions.add(attrs.get("id"))

    def content(node):
        parts = [escape(re.sub(r"\s+", " ", node.text or ""), quote=False)]
        for child in node:
            if local_name(child.tag) == "br":
                parts.append("\n")
            else:
                if any(key in child.attrib for key in ("begin", "end", "dur")):
                    raise ValueError("Timed inline text requires separate subtitle cues.")
                parts.append(content(child))
            parts.append(escape(re.sub(r"\s+", " ", child.tail or ""), quote=False))
        payload = "".join(parts)
        attrs = xml_attrs(node)
        font = None
        for ref in attrs.get("style", "").split():
            font = styles.get(ref, {}).get("fontStyle", font)
        if attrs.get("fontStyle", font) == "italic":
            return "<i>" + payload + "</i>"
        return payload

    cues = {}

    def visit(node, reference, limit, region):
        begin = reference + clock.seconds(node.get("begin", "0"))
        ends = [limit] if limit is not None else []
        if "end" in node.attrib:
            ends.append(reference + clock.seconds(node.attrib["end"]))
        if "dur" in node.attrib:
            ends.append(begin + clock.seconds(node.attrib["dur"]))
        end = min(ends) if ends else None
        region = node.get("region", region)
        if local_name(node.tag) == "p":
            if end is None:
                raise ValueError("Subtitle paragraph requires an end or duration.")
            if begin < end:
                payload = "\n".join(line.strip() for line in content(node).strip().split("\n"))
                if payload:
                    prefix = r"{\an8}" if region and region in top_regions else ""
                    cues.setdefault((begin, end), []).append(prefix + payload)
            return end
        latest = begin
        for child in node:
            if local_name(child.tag) in ("body", "div", "p"):
                start = latest if node.get("timeContainer") == "seq" else begin
                latest = max(latest, visit(child, start, end, region))
        return end if end is not None else latest

    visit(root, Fraction(0), None, None)
    result = []
    for index, ((begin, end), lines) in enumerate(sorted(cues.items()), 1):
        result.append(f"{index}\n{srt_stamp(begin)} --> {srt_stamp(end)}\n" + "\n".join(lines))
    return "\n\n".join(result) + ("\n" if result else "")


def main():
    directory = "."
    help_text = "path to the {} directory (defaults to current directory)"
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-i",
        "--input",
        type=str,
        default=directory,
        help=help_text.format("input", directory),
    )
    parser.add_argument(
        "-o",
        "--output",
        type=str,
        default=directory,
        help=help_text.format("output", directory),
    )
    a = parser.parse_args()
    filenames = [
        fn for fn in os.listdir(a.input) if fn[-4:].lower() in SUPPORTED_EXTENSIONS
    ]
    for fn in filenames:
        text = (Path(a.input) / fn).read_text(encoding="utf-8-sig")
        result = to_srt(text, fn[-4:])
        name = fn.replace(".vtt", "") + ".srt"
        (Path(a.output) / name).write_text(result, encoding="utf-8")


if __name__ == "__main__":
    main()
